DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=login@yourdomain.com
ADMIN_USER_IDS=

# --- Stripe ---------------------------------------------------------------------------------
# Prefer a RESTRICTED key (rk_…) over a secret key (sk_…). This integration needs only:
#   Checkout Sessions: write   ·   Prices: read
# Anything more is blast radius for no benefit. Use test-mode keys locally and for e2e; the
# suite creates real Checkout Sessions, so a live key here would put them on your live account.
STRIPE_SECRET_KEY=

# The Price to charge, created once in the Stripe dashboard (Product → add a one-off price).
# Must be a ONE-TIME price of USD 20.00 — createCheckout asserts unit_amount and currency match
# PRICE_CENTS/CURRENCY in lib/payments/provider.ts and throws on a mismatch, so a price edited
# in the dashboard fails loudly at checkout instead of silently charging a different amount.
STRIPE_PRICE_ID=

# Shown ONCE when you create the webhook endpoint (Developers → Webhooks). Unlike the previous
# provider's, this secret is unique to your endpoint, so a valid signature proves both integrity
# and account ownership — there is no second query-string gate. Locally, `stripe listen` prints
# its own whsec_… which is what you must use while forwarding:
#   stripe listen --forward-to localhost:3000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=

# Register exactly these events on the endpoint. Anything else is parsed as `other` and ignored:
#   checkout.session.completed          — grants access
#   checkout.session.async_payment_succeeded — grants access for delayed payment methods
#   charge.refunded                     — revokes access, but only on a FULL refund
#   charge.dispute.created              — revokes access (chargeback)

# Optional but STRONGLY recommended. Where to email when a payment webhook cannot be resolved
# (unresolvable_paid_event / row_still_pending / refund_target_not_found /
# pending_row_insert_failed). Without it these failures are only visible in logs.
PAYMENT_ALERT_EMAIL=
