DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=login@yourdomain.com
ABACATEPAY_API_KEY=
# Register your webhook URL in AbacatePay's dashboard WITH `?webhookSecret=<this value>`.
# Their HMAC key is public and shared by all merchants, so this query param is the only
# thing authenticating that a callback is for your account.
ABACATEPAY_WEBHOOK_SECRET=
# Create the R$110 "lifetime access" Product in AbacatePay FIRST, then paste its id here.
# Their checkout API references a pre-created Product by id; it does not accept inline
# line items. createCheckout throws until this is set, so every checkout would 500.
ABACATEPAY_PRODUCT_ID=
ADMIN_USER_IDS=
