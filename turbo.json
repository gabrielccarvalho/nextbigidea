{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "CI",
        "NEXT_DIST_DIR",
        "DATABASE_URL",
        "NEON_LOCAL_PROXY",
        "NEON_LOCAL_HTTP_HOST",
        "NEON_LOCAL_WS_HOST",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "PAYMENT_ALERT_EMAIL",
        "ADMIN_USER_IDS",
        "ABACATEPAY_API_KEY",
        "ABACATEPAY_PRODUCT_ID",
        "ABACATEPAY_WEBHOOK_SECRET",
        "ABACATEPAY_HMAC_PUBLIC_KEY",
        "PIPELINE_MONTHLY_USD_CAP",
        "PRODUCTHUNT_TOKEN",
        "REDDIT_USER_AGENT",
        "X_SESSION_COOKIE",
        "LINKEDIN_SESSION_COOKIE"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "CI",
        "NEXT_DIST_DIR",
        "DATABASE_URL",
        "NEON_LOCAL_PROXY",
        "NEON_LOCAL_HTTP_HOST",
        "NEON_LOCAL_WS_HOST",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "ABACATEPAY_API_KEY",
        "ABACATEPAY_PRODUCT_ID",
        "ABACATEPAY_WEBHOOK_SECRET",
        "ABACATEPAY_HMAC_PUBLIC_KEY"
      ]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
