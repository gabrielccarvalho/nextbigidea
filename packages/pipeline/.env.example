DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
OPENAI_API_KEY=sk-...
PIPELINE_MONTHLY_USD_CAP=5
# How far back to fetch, in days. 7 for weekly runs; raise for one-off backfills.
PIPELINE_SINCE_DAYS=7
SOURCE_HACKERNEWS=true
SOURCE_STACKEXCHANGE=true
SOURCE_GITHUB=true
# Personal access token (or `gh auth token`); needed for the GitHub source.
GITHUB_TOKEN=
# Optional stackapps.com app key: lifts the SE quota from 300 to 10,000 req/day.
STACKEXCHANGE_KEY=
# Unregistered sources, kept for reference only (see run.ts registry note).
SOURCE_REDDIT=false
SOURCE_PRODUCTHUNT=false
SOURCE_X=false
SOURCE_LINKEDIN=false
